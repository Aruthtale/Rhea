# Contoh konfigurasi RHEA — salin jadi .env.local lalu isi kunci aslimu.
# .env.local TIDAK boleh di-commit (sudah tercantum di .gitignore).
# Isi file ini hanya placeholder, bukan kunci asli.
#
# ATURAN PENTING:
#   - Prefix NEXT_PUBLIC_  → masuk ke bundle/APK, boleh terlihat umum
#   - TANPA prefix         → hanya di server, TIDAK PERNAH masuk APK
#
# JANGAN taruh secret (API key, OAuth client secret) di var NEXT_PUBLIC_!

# --- PUBLIC (boleh terlihat) ---------------------------------------------

# URL deployment Vercel. Dipakai app Android untuk nyamain server chat
# tanpa laptop nyala. Kosong saat dev lokal → otomatis pakai LAN fallback.
NEXT_PUBLIC_API_BASE_URL=

# OAuth 2.0 Client ID Google. Client ID publik by design.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps API key. Restrict ke Maps JS API + domain Vercel di Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- SERVER ONLY (jangan beri prefix NEXT_PUBLIC_) ------------------------

GEMINI_API_KEY=isi-kunci-gemini-di-sini
GEMINI_MODEL=gemini-3.8-flash

# OAuth 2.0 Client Secret Google — WAJIB dirahasiakan.
# Untuk Calendar, YouTube, Gmail, Sheets (butuh OAuth flow di server).
GOOGLE_CLIENT_SECRET=isi-oauth-client-secret-di-sini

# --- Local-only (jangan di-set di Vercel) --------------------------------
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=isi-kunci-9router-di-sini
ROUTER_MODEL=ArMes
